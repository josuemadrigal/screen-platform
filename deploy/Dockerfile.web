# Builds the two static frontends (admin panel + TV client) and packages them
# into a Caddy image that serves them over HTTPS and proxies the API.
# The API URL is NOT baked in: Caddy serves /config.js at runtime from DOMAIN,
# so one image works for any domain.
#
# Build context must be the repository root:
#   docker build -f deploy/Dockerfile.web -t josueahp/screen-web:latest .

# ---------- Frontend build stage ----------
FROM node:20-bookworm AS build
# Version stamped into the TV client and published in /updates/latest.json (git sha in CI).
ARG BUNDLE_VERSION=dev
ENV VITE_BUNDLE_VERSION=${BUNDLE_VERSION}
RUN apt-get update && apt-get install -y --no-install-recommends zip && rm -rf /var/lib/apt/lists/*
WORKDIR /src

COPY screenManager/package*.json ./screenManager/
RUN cd screenManager && npm ci --legacy-peer-deps

COPY screen-tv-client/package*.json ./screen-tv-client/
RUN cd screen-tv-client && npm ci

COPY screenManager ./screenManager
RUN cd screenManager && npm run build

COPY screen-tv-client ./screen-tv-client
RUN cd screen-tv-client && npm run build

# Live-update package for the Android app: zip of the built TV client + manifest.
RUN mkdir -p /src/updates && cd screen-tv-client/dist && zip -qr /src/updates/tv-${BUNDLE_VERSION}.zip . \
    && SUM=$(sha256sum /src/updates/tv-${BUNDLE_VERSION}.zip | cut -d' ' -f1) \
    && printf '{"version":"%s","path":"tv-%s.zip","checksum":"%s"}\n' "${BUNDLE_VERSION}" "${BUNDLE_VERSION}" "${SUM}" > /src/updates/latest.json

# ---------- Caddy build stage ----------
# Custom Caddy with DNS-challenge modules, so certificates can be issued even when
# ports 80/443 of the public IP are not available (validation happens via DNS records).
FROM caddy:2-builder AS caddy-build
RUN xcaddy build \
    --with github.com/caddy-dns/namecheap \
    --with github.com/caddy-dns/cloudflare \
    --with github.com/caddy-dns/duckdns

# ---------- Runtime stage ----------
FROM caddy:2-alpine

COPY --from=caddy-build /usr/bin/caddy /usr/bin/caddy
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY deploy/tls /etc/caddy/tls
COPY deploy/layout /etc/caddy/layout
# Map TLS_MODE to a site layout: duckdns needs one wildcard certificate, the rest one per host.
RUN cd /etc/caddy/layout && ln -s hosts.caddyfile http.caddyfile && ln -s hosts.caddyfile namecheap.caddyfile \
    && ln -s hosts.caddyfile cloudflare.caddyfile && ln -s wildcard.caddyfile duckdns.caddyfile \
    && ln -s wildcard.caddyfile duckdns-delegated.caddyfile
COPY --from=build /src/screenManager/dist /srv/panel
COPY --from=build /src/screen-tv-client/dist /srv/tv
COPY --from=build /src/updates /srv/updates

# Reverse proxy + static hosting with automatic HTTPS (Let's Encrypt).
# DOMAIN and ACME_EMAIL come from the environment (see .env.example).
#
#   panel.DOMAIN -> admin panel (static)
#   tv.DOMAIN    -> TV client   (static)
#   api.DOMAIN   -> NestJS API + Socket.IO + uploaded media
#
# The frontends read the API URL at runtime from /config.js (generated here from DOMAIN),
# so the same image works for any domain without rebuilding.

{
	email {$ACME_EMAIL}
}

(static-spa) {
	encode gzip zstd

	# Runtime configuration for the SPA: points it at the public API URL.
	handle /config.js {
		header Content-Type "application/javascript"
		header Cache-Control "no-cache"
		respond "window.__APP_CONFIG__ = { apiUrl: 'https://api.{$DOMAIN}', socketUrl: 'https://api.{$DOMAIN}' };" 200
	}

	handle {
		# Hashed assets can be cached for a long time; index.html must not.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
			Referrer-Policy strict-origin-when-cross-origin
		}
		try_files {path} /index.html
		file_server
	}
}

panel.{$DOMAIN} {
	root * /srv/panel
	import static-spa
}

tv.{$DOMAIN} {
	root * /srv/tv
	import static-spa
}

api.{$DOMAIN} {
	encode gzip
	# Uploads: no body size limit here; the API validates the file.
	# WebSocket (Socket.IO) upgrade is handled automatically by reverse_proxy.
	reverse_proxy api:4006 {
		flush_interval -1
	}
}

# Reverse proxy + static hosting with automatic HTTPS.
# All values come from the environment (see .env.example):
#
#   DOMAIN             base domain -> panel.DOMAIN, tv.DOMAIN, api.DOMAIN
#   ACME_EMAIL         Let's Encrypt contact
#   PUBLIC_PORT        port the sites listen on (443 by default; e.g. 8443 when 443 is taken)
#   PUBLIC_URL_SUFFIX  ":8443" when PUBLIC_PORT is not 443, empty otherwise (used in URLs)
#   TLS_MODE           how certificates are validated: http (ports 80/443 reachable) or
#                      namecheap / cloudflare / duckdns (DNS challenge, no ports needed)
#
# The frontends read the API URL at runtime from /config.js (generated here),
# so the same image works for any domain.

{
	email {$ACME_EMAIL}
}

# TLS issuance settings for the chosen mode (see deploy/tls/*.caddyfile)
import /etc/caddy/tls/{$TLS_MODE}.caddyfile

(static-spa) {
	encode gzip zstd

	# Runtime configuration for the SPA: points it at the public API URL.
	handle /config.js {
		header Content-Type "application/javascript"
		header Cache-Control "no-cache"
		respond "window.__APP_CONFIG__ = { apiUrl: 'https://api.{$DOMAIN}{$PUBLIC_URL_SUFFIX}', socketUrl: 'https://api.{$DOMAIN}{$PUBLIC_URL_SUFFIX}' };" 200
	}

	handle {
		# Hashed assets can be cached for a long time; index.html must not.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
			Referrer-Policy strict-origin-when-cross-origin
		}
		try_files {path} /index.html
		file_server
	}
}

panel.{$DOMAIN}:{$PUBLIC_PORT} {
	import tls-issuer
	root * /srv/panel
	import static-spa
}

tv.{$DOMAIN}:{$PUBLIC_PORT} {
	import tls-issuer
	root * /srv/tv
	import static-spa
}

api.{$DOMAIN}:{$PUBLIC_PORT} {
	import tls-issuer
	encode gzip
	# Uploads: no body size limit here; the API validates the file.
	# WebSocket (Socket.IO) upgrade is handled automatically by reverse_proxy.
	reverse_proxy api:4006 {
		flush_interval -1
	}
}

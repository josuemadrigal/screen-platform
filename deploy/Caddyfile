# Reverse proxy + static hosting with automatic HTTPS.
# All values come from the environment (see .env.example):
#
#   PANEL_HOST / TV_HOST / API_HOST   hostnames of the three sites (compose derives them
#                      from DOMAIN when not set: DOMAIN, tv.DOMAIN, api.DOMAIN)
#   ACME_EMAIL         Let's Encrypt contact
#   PUBLIC_PORT        port the sites listen on (443 by default; e.g. 8443 when 443 is taken)
#   PUBLIC_URL_SUFFIX  ":8443" when PUBLIC_PORT is not 443, empty otherwise (used in URLs)
#   TLS_MODE           how certificates are validated: http (ports 80/443 reachable) or
#                      namecheap / cloudflare / duckdns (DNS challenge, no ports needed) or
#                      duckdns-delegated (customer domain, validation delegated to DuckDNS by CNAME)
#
# The frontends read the API URL at runtime from /config.js (generated here),
# so the same image works for any domain.

{
	email {$ACME_EMAIL}
}

# TLS issuance settings for the chosen mode (see deploy/tls/*.caddyfile)
import /etc/caddy/tls/{$TLS_MODE}.caddyfile

# Live-update packages for the Android app (see deploy/Dockerfile.web, screen-tv-client/src/hooks/useLiveUpdate.ts)
(app-updates) {
	handle /updates/* {
		root * /srv
		header Cache-Control "no-cache"
		# The Android app fetches the manifest from its own origin (https://localhost).
		header Access-Control-Allow-Origin "*"
		file_server
	}
}

(static-spa) {
	encode gzip zstd

	# Runtime configuration for the SPA: points it at the public API URL.
	handle /config.js {
		header Content-Type "application/javascript"
		header Cache-Control "no-cache"
		respond "window.__APP_CONFIG__ = { apiUrl: 'https://{$API_HOST}{$PUBLIC_URL_SUFFIX}', socketUrl: 'https://{$API_HOST}{$PUBLIC_URL_SUFFIX}' };" 200
	}

	handle {
		# Hashed assets can be cached for a long time; index.html must not.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# The document itself must always be revalidated, whether requested as / or /index.html
		@index path / /index.html
		header @index Cache-Control "no-cache"
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
			Referrer-Policy strict-origin-when-cross-origin
		}
		try_files {path} /index.html
		file_server
	}
}

# Site layout for the chosen mode (see deploy/layout/*.caddyfile): duckdns -> wildcard, others -> hosts
import /etc/caddy/layout/{$TLS_MODE}.caddyfile

# Copy to .env next to docker-compose.server.yml on the server and fill in.

# Image tag to deploy: latest, or sha-<commit> to pin/roll back (tags published by GitHub Actions)
IMAGE_TAG=latest

# Base domain. By default the panel answers on DOMAIN itself, the TV client on tv.DOMAIN and
# the API on api.DOMAIN. Every hostname used must point to this server (A record, or CNAME to
# the router's DDNS name) before starting.
DOMAIN=example.com
# Optional: override any of the three hostnames, e.g. TV_HOST=tv.otherdomain.com
#PANEL_HOST=
#TV_HOST=
#API_HOST=
# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=hola@example.com

# --- Ports and certificates ---
# Normal case: ports 80 and 443 of the public IP reach this server. Leave as is.
#   PUBLIC_PORT=443  PUBLIC_URL_SUFFIX=  TLS_MODE=http
# When 80/443 are taken by another server and the router translates e.g. 8443 -> this server:
#   PUBLIC_PORT=8443  PUBLIC_URL_SUFFIX=:8443  TLS_MODE=<dns provider>
# Sites are then reached at https://panel.DOMAIN:8443 etc. and certificates are validated via DNS.
PUBLIC_PORT=443
PUBLIC_URL_SUFFIX=
TLS_MODE=http
# TLS_MODE=namecheap: API enabled on the account, PUBLIC_IP whitelisted, domain on Namecheap BasicDNS
PUBLIC_IP=
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
# TLS_MODE=cloudflare: API token with Zone.DNS edit on the zone
CLOUDFLARE_API_TOKEN=
# TLS_MODE=duckdns: account token. Uses one wildcard certificate, so set PANEL_HOST=panel.DOMAIN
# and add COMPOSE_PROFILES=duckdns to run the IP updater (router WAN failover).
DUCKDNS_TOKEN=
#COMPOSE_PROFILES=duckdns
# Optional: keep DuckDNS pointed at the router's own DDNS name (handles WAN failover)
#DDNS_FOLLOW_HOST=xxxxxxxxxxxx.sn.mynetname.net

# Database (internal only, never published)
POSTGRES_USER=screen_user
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=screen_db

# API
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-long-random
JWT_EXPIRATION=24h
TZ=America/Santo_Domingo
# Where uploaded videos live on the host (absolute path recommended)
STORAGE_PATH=/opt/screen-platform/storage

# Optional WhatsApp/bot integration
BOT_URL=
BOT_IMG_screen=
BOT_API_KEY=

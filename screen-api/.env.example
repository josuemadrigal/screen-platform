# Copy to .env and fill in real values. .env is git-ignored.

# Database (local development, outside Docker; the port maps to the compose container)
DATABASE_URL="postgresql://screen_user:screen_password@localhost:5437/screen_db?schema=public"

# Postgres container credentials (used by docker-compose)
POSTGRES_USER=screen_user
POSTGRES_PASSWORD=screen_password
POSTGRES_DB=screen_db

# App
PORT=4006
NODE_ENV=development

# JWT
JWT_SECRET=change-me
JWT_EXPIRATION=24h

# Bot
BOT_URL=http://localhost:4011/v1
# Only used by docker-compose (the bot runs on the host, not inside the container)
BOT_URL_DOCKER=http://host.docker.internal:4011/v1
BOT_IMG_screen=https://example.com/image.jpeg
BOT_API_KEY=change-me
